# ---- Copy this file to .env.local and fill in the values ----
# (scripts/setup-aws.sh can generate this file for you automatically)

# Admin login — you choose these. Used only on the server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# AWS region where the table + bucket live
AWS_REGION=us-east-1

# DynamoDB table name (created by scripts/setup-aws.sh)
DYNAMODB_TABLE=baby-registry

# S3 bucket for uploaded product photos (must be globally unique)
S3_BUCKET=baby-registry-images-CHANGEME

# AWS credentials for an IAM user scoped to the table + bucket.
# Locally: put them here. On Vercel: set them in Project Settings > Environment Variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Branding shown in the public header
NEXT_PUBLIC_REGISTRY_TITLE=Baby Registry
NEXT_PUBLIC_REGISTRY_SUBTITLE=We're having a baby!

# Tax multiplier applied to the price shown to guests (so they see the out-the-door cost).
# 1.13 = 13% tax (e.g. Ontario HST). Use 1 for no tax, 1.08 for 8%, etc.
NEXT_PUBLIC_TAX_MULTIPLIER=1.13

# How long (in seconds) a hold is kept before it auto-expires.
# Default is 1800 (30 minutes). Items are also released immediately
# when the visitor closes or refreshes the page.
# HOLD_TTL_SECONDS=5400  # 1h30m — matches the guided checkout copy

# ── RSVP confirmation emails (sent from your personal Gmail) ──
# GMAIL_APP_PASSWORD is a Gmail App Password, NOT your regular password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# ── Event details shown in the RSVP confirmation email ──
# Any blank value is simply omitted from the email.
EVENT_NAME="Baby Shower"
VENUE_NAME="The Venue Name"
VENUE_ADDRESS="123 Main St, City, Province"
EVENT_TIME="Saturday, August 15 2026, 2:00 PM"
ATTIRE_MEN="Smart casual"
ATTIRE_WOMEN="Garden party attire"
